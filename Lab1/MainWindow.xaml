<Window x:Class="Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1"
        mc:Ignorable="d"
        Title="Лабораторная работа по компьютерной графике" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Загрузить изображение" Click="LoadImage_Click" 
                    Width="180" Height="30" Margin="5"/>
            <Button Content="Сохранить результат" Click="SaveImage_Click" 
                    Width="180" Height="30" Margin="5"/>
            <TextBlock x:Name="StatusText" Text="Изображение не загружено" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Вкладки для заданий -->
        <TabControl Grid.Row="1" Margin="10" x:Name="MainTabControl">

            <!-- Задание 1 -->
            <TabItem Header="Задание 1: Оттенки серого">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Изображения -->
                        <WrapPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="Оригинал" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="OriginalImage" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="ЧБ (PAL/NTSC)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="Grayscale1Image" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="ЧБ (HDTV)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="Grayscale2Image" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="Разность" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="DifferenceImage" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Гистограммы -->
                        <TextBlock Text="Гистограммы интенсивности" FontWeight="Bold" 
                                   FontSize="14" Margin="0,10,0,5"/>
                        <WrapPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма PAL/NTSC" HorizontalAlignment="Center"/>
                                <Canvas x:Name="Histogram1Canvas" Width="400" Height="200" 
                                        Background="White" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма HDTV" HorizontalAlignment="Center"/>
                                <Canvas x:Name="Histogram2Canvas" Width="400" Height="200" 
                                        Background="White" Margin="5"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Задание 2 (заглушка для второго участника) -->
            <!-- Задание 2 -->
            <TabItem Header="Задание 2: Каналы RGB">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <!-- Изображения каналов -->
                        <WrapPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Красный канал (R)"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                                <Image x:Name="RedChannelImage"
                           Width="250"
                           Height="250"
                           Stretch="Uniform"
                           Margin="5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Зелёный канал (G)"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                                <Image x:Name="GreenChannelImage"
                           Width="250"
                           Height="250"
                           Stretch="Uniform"
                           Margin="5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Синий канал (B)"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                                <Image x:Name="BlueChannelImage"
                           Width="250"
                           Height="250"
                           Stretch="Uniform"
                           Margin="5"/>
                            </StackPanel>

                        </WrapPanel>


                        <!-- Гистограммы -->
                        <TextBlock Text="Цветовые гистограммы"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,10,0,5"/>

                        <WrapPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма R"
                               HorizontalAlignment="Center"/>

                                <Canvas x:Name="RedHistogramCanvas"
                            Width="350"
                            Height="200"
                            Background="White"
                            Margin="5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма G"
                               HorizontalAlignment="Center"/>

                                <Canvas x:Name="GreenHistogramCanvas"
                            Width="350"
                            Height="200"
                            Background="White"
                            Margin="5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма B"
                               HorizontalAlignment="Center"/>

                                <Canvas x:Name="BlueHistogramCanvas"
                            Width="350"
                            Height="200"
                            Background="White"
                            Margin="5"/>
                            </StackPanel>

                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Задание 3 (заглушка для третьего участника) -->
            <TabItem Header="Задание 3: HSV">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Настройка изображения в пространстве HSV" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Оттенок"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="HueValueText" DockPanel.Dock="Right" Width="65" Text="0°" VerticalAlignment="Center" TextAlignment="Right"/>
                                <Slider x:Name="HueSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="HsvSlider_ValueChanged"/>
                            </DockPanel>
                            <TextBlock Text="Насыщенность"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="SaturationValueText" DockPanel.Dock="Right" Width="65" Text="0%" VerticalAlignment="Center" TextAlignment="Right"/>
                                <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="HsvSlider_ValueChanged"/>
                            </DockPanel>
                            <TextBlock Text="Яркость (Value)"/>
                            <DockPanel>
                                <TextBlock x:Name="ValueValueText" DockPanel.Dock="Right" Width="65" Text="0%" VerticalAlignment="Center" TextAlignment="Right"/>
                                <Slider x:Name="ValueSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="HsvSlider_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="HsvStatusText" Text="Загрузите изображение, чтобы начать." Margin="0,0,0,8"/>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
                            <StackPanel Margin="8" HorizontalAlignment="Center">
                                <TextBlock Text="Оригинал" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="HsvOriginalImage" Width="350" Height="350" Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="8" HorizontalAlignment="Center">
                                <TextBlock Text="Результат HSV → RGB" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="HsvResultImage" Width="350" Height="350" Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
