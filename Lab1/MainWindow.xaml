<Window x:Class="Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1"
        mc:Ignorable="d"
        Title="Лабораторная работа по компьютерной графике" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Загрузить изображение" Click="LoadImage_Click" 
                    Width="180" Height="30" Margin="5"/>
            <Button Content="Сохранить результат" Click="SaveImage_Click" 
                    Width="180" Height="30" Margin="5"/>
            <TextBlock x:Name="StatusText" Text="Изображение не загружено" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Вкладки для заданий -->
        <TabControl Grid.Row="1" Margin="10" x:Name="MainTabControl">

            <!-- Задание 1 -->
            <TabItem Header="Задание 1: Оттенки серого">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Изображения -->
                        <WrapPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="Оригинал" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="OriginalImage" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="ЧБ (PAL/NTSC)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="Grayscale1Image" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="ЧБ (HDTV)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="Grayscale2Image" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="Разность" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image x:Name="DifferenceImage" Width="250" Height="250" 
                                       Stretch="Uniform" Margin="5"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Гистограммы -->
                        <TextBlock Text="Гистограммы интенсивности" FontWeight="Bold" 
                                   FontSize="14" Margin="0,10,0,5"/>
                        <WrapPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма PAL/NTSC" HorizontalAlignment="Center"/>
                                <Canvas x:Name="Histogram1Canvas" Width="400" Height="200" 
                                        Background="White" Margin="5"/>
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="Гистограмма HDTV" HorizontalAlignment="Center"/>
                                <Canvas x:Name="Histogram2Canvas" Width="400" Height="200" 
                                        Background="White" Margin="5"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Задание 2 (заглушка для второго участника) -->
            <TabItem Header="Задание 2: Каналы RGB">
                <Grid>
                    <TextBlock Text="Задание 2: Выделение каналов R, G, B и цветовые гистограммы" 
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- Задание 3 (заглушка для третьего участника) -->
            <TabItem Header="Задание 3: HSV">
                <Grid>
                    <TextBlock Text="Задание 3: Преобразование RGB в HSV с ползунками" 
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>